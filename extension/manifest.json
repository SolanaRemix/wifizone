{
  "manifest_version": 3,
  "name": "WIFIZONE Manager",
  "version": "1.0.0",
  "description": "Quick access to your WIFIZONE hotspot dashboard — see live stats, active users, and earnings at a glance.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://192.168.*.*/*",
    "http://10.*.*.*/*",
    "http://172.16.*.*/*",
    "http://172.17.*.*/*",
    "http://172.18.*.*/*",
    "http://172.19.*.*/*",
    "http://172.20.*.*/*",
    "http://172.21.*.*/*",
    "http://172.22.*.*/*",
    "http://172.23.*.*/*",
    "http://172.24.*.*/*",
    "http://172.25.*.*/*",
    "http://172.26.*.*/*",
    "http://172.27.*.*/*",
    "http://172.28.*.*/*",
    "http://172.29.*.*/*",
    "http://172.30.*.*/*",
    "http://172.31.*.*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WIFIZONE Manager",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
